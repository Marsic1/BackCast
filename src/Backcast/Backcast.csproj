<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Backcast</RootNamespace>
    <AssemblyName>Backcast</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.1.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- One-file release: everything (runtime + libmpv) inside Backcast.exe;
         the DLL is unpacked to a temp dir automatically on first run. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- one file means ONE file: no satellite language folders next to the exe -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Dev builds: libmpv DLL fetched by tools/fetch-libmpv.ps1, copied next to the exe -->
  <ItemGroup>
    <Content Include="libmpv\libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Link="libmpv-2.dll" />
  </ItemGroup>

</Project>
