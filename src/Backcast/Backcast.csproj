<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Backcast</RootNamespace>
    <AssemblyName>Backcast</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.5.2</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- One-file release: runtime + the OBS plugin embedded as a resource. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- one file means ONE file: no satellite language folders next to the exe -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- multi-size app icon: exe icon + embedded resource for tray/titlebar -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <!-- The OBS plugin payload, embedded and extracted by PluginInstaller.
       Build the plugin first with its cmake presets (configure + build). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\plugin\build_x64\Release\backcast-projector.dll" Link="assets\backcast-projector.dll" />
    <EmbeddedResource Include="..\..\plugin\data\locale\en-US.ini" Link="assets\en-US.ini" />
  </ItemGroup>

</Project>
